<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: aviso local cuando termina una subida (se pide al empezar la primera subida, no al abrir la app). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Servicio en primer plano que mantiene viva una subida de video con la app en segundo plano (Fase 6C, opción B). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MovieNightApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovieNight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MovieNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mantiene vivo el proceso mientras se sube un video con la app en segundo plano; no sube nada por sí mismo. -->
        <service
            android:name=".notify.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>