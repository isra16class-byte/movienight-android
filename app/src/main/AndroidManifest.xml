<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: aviso local cuando termina una subida (se pide al empezar la primera subida, no al abrir la app). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Servicio en primer plano que mantiene viva una subida de video con la app en segundo plano (Fase 6C, opción B). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MovieNightApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovieNight">
        <!--
          Fase 7A: configChanges evita que Android recree la actividad al entrar y salir de la ventana flotante (PiP)
          y al girar el teléfono: la actividad se queda viva y recibe onConfigurationChanged. Sin esto, al cerrar la
          ventana con la X Android destruía y recreaba la actividad y nunca mandaba el cambio de modo de PiP, así que
          el video no se pausaba (medido con los logs DEBUG-X). Es una hipótesis a confirmar en el emulador: que con
          esto el cambio de modo llegue a la misma instancia. Otros cambios de configuración (tema oscuro, idioma,
          tamaño de letra) siguen recreando la actividad, y PauseWhenAppStops sigue sin pausar en ese caso.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MovieNight">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mantiene vivo el proceso mientras se sube un video con la app en segundo plano; no sube nada por sí mismo. -->
        <service
            android:name=".notify.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>