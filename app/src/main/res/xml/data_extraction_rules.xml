<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas para Android 12+. La cookie de sesión (movienight.sid) no debe salir del dispositivo,
     ni el userId por dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="movienight_cookies.xml" />
        <exclude domain="sharedpref" path="movienight_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="movienight_cookies.xml" />
        <exclude domain="sharedpref" path="movienight_identity.xml" />
    </device-transfer>
</data-extraction-rules>
